# Copy to .env for local development.
# Publishable values are safe for the browser; never commit the service-role key
# or the database URL.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server-side (SSR) reads. Same values as above; set in Vercel as well.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# Server-only. Never expose to the client bundle.
# SUPABASE_SERVICE_ROLE_KEY=""

# Direct Postgres connection string, used only by drizzle-kit. Never expose.
# SUPABASE_DB_URL=""
